generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  emailToken    String?   @map("email_token")
  image         String?
  password      String?
  passwordToken String?   @map("password_token")

  @@map("users")
}

model Family {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  kkNumber        String             @unique @map("kk_number")
  address         String
  rt              String
  rw              String
  subDistrict     String             @map("sub_district")
  district        String
  city            String
  province        String
  postalCode      String             @map("postal_code")
  publishDate     DateTime           @map("publish_date")
  familyMembers   FamilyMember[]

  @@map("families")
}

model FamilyMember {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  familyRelation FamilyRelation @map("family_relation")
  family         Family         @relation(fields: [familyId], references: [id])
  familyId       String         @map("family_id") @db.ObjectId
  residentId     String         @unique @map("resident_id") @db.ObjectId
  resident       Resident       @relation(fields: [residentId], references: [id])

  @@map("family_members")
}

model Resident {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  nik             String         @unique
  name            String
  birthPlace      String         @map("birth_place")
  birthDate       DateTime       @map("birth_date")
  gender          Gender         @default(MALE)
  religion        Religion
  education       Education
  work            String?
  marriageStatus  MarriageStatus @default(BELUM_KAWIN) @map("marriage_status")
  nationality     Nationality    @default(WNI)
  phone           String?
  familyMember    FamilyMember?
  
  @@map("residents")
  @@index([name])
  @@index([birthDate])
}

enum Gender {
  MALE
  FEMALE
}

enum Religion {
  ISLAM
  KRISTEN
  HINDU
  BUDHA
  KATOLIK
  KONGHUCU
  OTHERS
}

enum Education {
  SD
  SMP
  SMA_SMK
  D1
  D2
  D3
  D4
  S1
  S2
  S3
}

enum MarriageStatus {
  BELUM_KAWIN
  KAWIN
  CERAI_HIDUP
  CERAI_MATI
}

enum Nationality {
  WNI
  WNA
}

enum FamilyRelation {
  KEPALA_KELUARGA
  SUAMI
  ISTRI
  ANAK
  ORANG_TUA
  MERTUA
}